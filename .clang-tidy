Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  clang-analyzer-*

WarningsAsErrors: '*'
HeaderFilterRegex: 'include/nanofix\.hpp$|include/nanofix/detail/(config|diagnostics|simd|numeric|time|writer|value_iter|reader|index|typed)\.hpp$'
FormatStyle: file
